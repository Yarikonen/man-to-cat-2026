{
  "dashboard": {
    "title": "Ingestion Metrics",
    "panels": [
      {
        "title": "Ingestion Rate by Source",
        "targets": [{"expr": "rate(images_ingested_total[5m])", "legendFormat": "{{source}} - {{method}}"}],
        "type": "graph"
      },
      {
        "title": "Rejection Rate by Reason",
        "targets": [{"expr": "rate(images_rejected_total[5m])", "legendFormat": "{{reason}}"}],
        "type": "graph"
      },
      {
        "title": "Validation Duration (p95)",
        "targets": [{"expr": "histogram_quantile(0.95, image_validation_duration_seconds_bucket)"}],
        "type": "graph"
      },
      {
        "title": "COCO Download Rate",
        "targets": [{"expr": "rate(coco_images_downloaded_total[5m])"}],
        "type": "graph"
      },
      {
        "title": "COCO Rejection Reasons",
        "targets": [{"expr": "rate(coco_images_rejected_total[5m])", "legendFormat": "{{reason}}"}],
        "type": "graph"
      }
    ]
  }
}
