# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
HF_TOKEN=your_hugging_face_token

# Chat for Alertmanager → Telegram alerts (int; negative for groups).
# Reuses the same bot token above for sending.
TELEGRAM_ALERT_CHAT_ID=

# Model params
MODEL_DEVICE=cpu
CONTENT_ENCODER_NAME=content_encoder.pt
GENERATOR_NAME=face2cat.pt
EMBEDDING_HF_MODEL_NAME="facebook/dinov3-vitb16-pretrain-lvd1689m"
SCHRODINGER_BRIDGE_PARAMS=schrodinger_bridge.npz
SCHRODINGER_BRIDGE_CATS_PATHS=cats_paths.txt

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

MINIO_BUCKET_ORIGINALS=originals
MINIO_BUCKET_PROCESSED=processed
MINIO_BUCKET_RAW=raw-images
MINIO_BUCKET_MODEL=model-weights

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=image_processing_queue

# Database (shared volume between bot and model-service)
DATABASE_PATH=/data/images.db

# Monitoring Ports
PROMETHEUS_PORT=8000
MODEL_SERVICE_PORT=8002
