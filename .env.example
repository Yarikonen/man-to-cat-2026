# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat for Alertmanager → Telegram alerts (int; negative for groups).
# Reuses the same bot token above for sending.
TELEGRAM_ALERT_CHAT_ID=

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ORIGINALS=originals
MINIO_BUCKET_PROCESSED=processed
MINIO_SECURE=false

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=image_processing_queue

# PostgreSQL
DATABASE_URL=postgresql://app:app@postgres:5432/man_to_cat

# Monitoring Ports
PROMETHEUS_PORT=8000
MODEL_SERVICE_PORT=8002
